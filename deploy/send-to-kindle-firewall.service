[Unit]
Description=send-to-kindle: what the engine's user may connect to (nftables table inet send_to_kindle)
Before=send-to-kindle.service
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/send-to-kindle/egress.nft
ExecReload=/usr/sbin/nft -f /etc/send-to-kindle/egress.nft
ExecStop=/usr/sbin/nft delete table inet send_to_kindle

[Install]
WantedBy=multi-user.target
