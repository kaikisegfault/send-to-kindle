#!/usr/sbin/nft -f
# Where the engine's user (kindle) may connect: the library's git host and the mail service (addresses.nft,
# refreshed hourly by send-to-kindle-addresses.timer), and local DNS. Nothing else: no other website, nothing
# on this server, no private address. The engine takes no links.
# Loaded by send-to-kindle-firewall.service before the engine starts; replies on connections made to the
# engine (state established) always pass.

table inet send_to_kindle {}
delete table inet send_to_kindle

table inet send_to_kindle {
	set git4 { type ipv4_addr; flags interval; auto-merge; }
	set git6 { type ipv6_addr; flags interval; auto-merge; }
	set git_port { type inet_service; }
	set mail4 { type ipv4_addr; flags interval; auto-merge; }
	set mail6 { type ipv6_addr; flags interval; auto-merge; }
	set mail_port { type inet_service; }

	chain output {
		type filter hook output priority filter; policy accept;
		meta skuid "kindle" jump engine
	}

	chain engine {
		ct state established,related accept
		ip daddr 127.0.0.53 meta l4proto { tcp, udp } th dport 53 accept
		ip daddr @git4 tcp dport @git_port accept
		ip6 daddr @git6 tcp dport @git_port accept
		ip daddr @mail4 tcp dport @mail_port accept
		ip6 daddr @mail6 tcp dport @mail_port accept
		counter drop
	}
}

include "/etc/send-to-kindle/addresses.nft"
