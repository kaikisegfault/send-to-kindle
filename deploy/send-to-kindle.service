[Unit]
Description=send-to-kindle engine
Requires=send-to-kindle-firewall.service send-to-kindle-dns.service send-to-kindle-convert.socket
After=network-online.target send-to-kindle-firewall.service send-to-kindle-dns.service send-to-kindle-convert.socket
Wants=network-online.target

[Service]
User=kindle
Group=kindle
EnvironmentFile=/etc/send-to-kindle/settings
Environment=HOME=/var/lib/send-to-kindle PYTHONPATH=/opt/send-to-kindle
WorkingDirectory=/var/lib/send-to-kindle
# Its own resolver (send-to-kindle-dns.service): the only one its firewall lets it use.
BindReadOnlyPaths=/etc/send-to-kindle/resolv.conf:/etc/resolv.conf
ExecStart=/opt/send-to-kindle/.venv/bin/python -m send_to_kindle serve
Restart=on-failure
RestartSec=5

# Lowest priority: anything else on the server always comes first.
Nice=19
CPUWeight=10
IOSchedulingClass=idle
# Files are opened by the converter (send-to-kindle-convert@.service), so the engine itself stays small.
MemoryHigh=200M
MemoryMax=300M
TasksMax=64

# Hardening: it can write only its own state directory (the firewall table narrows its network).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/send-to-kindle
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
